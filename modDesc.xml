<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<modDesc descVersion="113">
    <author>PropaineX</author>
    <version>0.2.1.0</version>
    <title>
        <en>Monthly Expense Sheet Pro Edition</en>
    </title>
    <description>
        <en><![CDATA[Keeps a record of every money change on your farm, the same ones that pop up under your balance in the top right corner, and sorts them by month. Money that changes without a popup is caught too and listed as "Untracked balance changes", so the sheet always adds up to what happened to your balance.

Press Left Alt + M to open the sheet. Expenses and income are listed by category with the number of charges, the month's total and last month's total. Select a category to see every single charge with its date and time.

Q / E: previous / next month. Arrow keys: select a category. Left / Right: switch between expenses and income. Mouse wheel scrolls the details. Esc or Left Alt + M closes the sheet.

The records are saved with your savegame (the last 24 months). Works in multiplayer: the server keeps the records, each player sees their own farm.]]></en>
    </description>
    <iconFilename>icon_MonthlyExpenseSheet.dds</iconFilename>
    <multiplayer supported="true" />

    <extraSourceFiles>
        <sourceFile filename="scripts/MonthlyExpenseSheet.lua" />
        <sourceFile filename="scripts/MonthlyExpenseSheetEvents.lua" />
        <sourceFile filename="scripts/MonthlyExpenseSheetDisplay.lua" />
    </extraSourceFiles>

    <actions>
        <action name="MES_TOGGLE_SHEET" />
    </actions>

    <inputBinding>
        <actionBinding action="MES_TOGGLE_SHEET">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lalt KEY_m" />
        </actionBinding>
    </inputBinding>

